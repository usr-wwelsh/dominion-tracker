# Copy this file to .env and fill in values before deploying.

# Path to the SQLite database file (inside the container or local dev)
SQLITE_PATH=/data/dominion.db

# Global login for protected actions
AUTH_USER=admin
AUTH_PASS=changeme

# VAPID keys for web push (generate once with: npx web-push generate-vapid-keys)
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@example.com

# Host port the app is exposed on (default 3002 in compose)
APP_PORT=3002
